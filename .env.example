# Firebase Web app config; safe for the browser but data access is enforced by Security Rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=

# Exactly the two journal members, comma-separated.
# This is only the frontend invitation gate; deployed Firebase rules enforce access.
VITE_ALLOWED_EMAILS=you@example.com,her@example.com
PARALY_MEMBER_EMAILS=you@example.com,her@example.com
PARALY_PARTNER_EMAIL=her@example.com

# Local-only Firebase Admin service-account path for scripts/seed-members.mjs.
# Keep the JSON file outside the repository. Never commit it.
GOOGLE_APPLICATION_CREDENTIALS=

# Server-only secrets for Google Drive storage. Never prefix these with VITE_.
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
PARALY_DRIVE_REDIRECT_URI=http://localhost:53682/oauth2callback

# Required in Vercel for Admin SDK API routes; store the base64-encoded JSON key.
# This can stay empty in local .env.local when GOOGLE_APPLICATION_CREDENTIALS is set.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
