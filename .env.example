# ParAly's public Firebase web configuration is prefilled in src/firebase.js.
# Set these only to override the checked-in public defaults for another deployment/project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=paraly-2bfb7
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Existing asia-southeast1 Realtime Database URL.
VITE_FIREBASE_DATABASE_URL=https://paraly-2bfb7-default-rtdb.asia-southeast1.firebasedatabase.app

# Optional front-end sign-in hint. Security is enforced by Firebase rules and member records.
# Use the exact two Google account addresses if you want the UI to reject other accounts early.
VITE_ALLOWED_EMAILS=

# Server-only invitation allowlist. Set this in Vercel too; do NOT prefix it with VITE_.
# The protected first-login endpoint provisions approved accounts only when they sign in.
PARALY_MEMBER_EMAILS=

# Local-only Admin SDK bootstrap. Keep the service-account key outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_DATABASE_URL=https://paraly-2bfb7-default-rtdb.asia-southeast1.firebasedatabase.app

# Server-only Google Drive settings. Never expose these as VITE_ variables.
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
PARALY_PARTNER_EMAIL=
PARALY_DRIVE_REDIRECT_URI=http://localhost:53682/oauth2callback

# Server-only credential for Vercel API routes. Base64-encode the JSON locally and set in Vercel.
# Never commit the credential JSON or expose this under a VITE_* name.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
