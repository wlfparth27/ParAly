# Firebase web app configuration (set locally and in your deployment environment).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Exactly the two approved Google accounts, comma-separated.
# This is a UI gate only; Firestore, Realtime Database, and Storage rules
# must independently enforce membership before cloud journal data is stored.
VITE_ALLOWED_EMAILS=you@example.com,her@example.com
