# Firebase web app configuration (set locally and in your deployment environment).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=

# Exactly the two approved Google accounts, comma-separated.
# Client-side invitation gate only; Firebase Security Rules are the real security boundary.
VITE_ALLOWED_EMAILS=you@example.com,her@example.com

# Used only by scripts/seed-members.mjs on your own computer, never by the browser.
GOOGLE_APPLICATION_CREDENTIALS=
PARALY_MEMBER_EMAILS=you@example.com,her@example.com
FIREBASE_DATABASE_URL=
